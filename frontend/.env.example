# Backend API base URL (include /api/v1)
# Local dev: leave blank — Vite proxy handles it
# Production: set to your backend domain
VITE_API_URL=https://api.yourdomain.com/api/v1

# Laravel Reverb WebSocket (real-time messaging)
VITE_REVERB_APP_KEY=your-reverb-app-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
